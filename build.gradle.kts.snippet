// MDX-LiteRT dependencies for the Android app module.
// LiteRT 2.x provides the modern CompiledModel API with GPU/CPU fallback.
implementation("com.google.ai.edge.litert:litert:2.2.0")
implementation("com.github.wendykierp:JTransforms:3.1")

// Keep your existing native DSP target alongside the player's existing EQ and
// stereo-widener targets. Do NOT replace libpeq/libwidener.
externalNativeBuild {
    cmake {
        path = file("src/main/cpp/CMakeLists.txt")
    }
}

